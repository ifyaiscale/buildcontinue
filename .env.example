# Node.js 24. Copy to .env.local; never commit real secrets.
# In development, leaving auth unset starts a PUBLIC DEMO. Do not enter real data.
# Production fails closed without authentication and APP_URL.
APP_URL=http://localhost:3000
# Optional development-only adapter for a proxy that rewrites Origin and Host.
# Requires HTTPS APP_URL and private authentication; signed CSRF proofs are mandatory.
# DEV_PROXY_ORIGIN=http://localhost:3000
# Optional JSON map of exact checkout origins to existing brand slugs.
# Production requires HTTPS; hosts must differ from APP_URL and be verified/configured at your host.
# CHECKOUT_ORIGINS={"https://checkout.brand.example":"brand-slug"}
CHECKOUT_ORIGINS={}
DATABASE_PATH=./data/limitless.sqlite
# For Supabase, save the transaction-pooler URI privately and run npm run db:migrate.
# DATABASE_URL takes precedence over DATABASE_PATH. Omit it entirely to use SQLite.
# DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:6543/postgres
# Supabase's public root CA is bundled. Optional PEM override for another CA:
# DATABASE_CA_CERT=

# Prefer a scrypt hash. Generate using the command in README.md.
ADMIN_PASSWORD_HASH=
# Alternative: random password of at least 16 characters. Hash takes precedence.
ADMIN_PASSWORD=
# Generate independently: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Payment gates fail closed. Merchant acceptance and shopper activation are separate.
# Shopper payment requires BOTH values to be true, plus a live brand with verified providers.
# Leave PUBLIC_PAYMENT_ENABLED false/unset until controlled launch acceptance passes.
PAYMENT_ACCEPTANCE_ENABLED=false
PUBLIC_PAYMENT_ENABLED=false

# Shopify and Whop API credentials are entered only in the authenticated app,
# verified against provider APIs, and encrypted before database storage.
